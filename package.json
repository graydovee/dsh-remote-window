{
  "name": "dsh-remote-workspace",
  "version": "0.1.0-alpha28",
  "description": "Open an SSH host as a DeepSeek Harness workspace: a headless execution-world server runs on the remote machine while the agent loop, models and credentials stay local.",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./connection": {
      "types": "./lib/types/connection/index.d.ts",
      "default": "./lib/connection.js"
    },
    "./package.json": "./package.json",
    "./protocol": {
      "types": "./lib/types/protocol.d.ts",
      "default": "./lib/protocol.js"
    },
    "./rsession": {
      "types": "./lib/types/rsession/remote-persistence.d.ts",
      "default": "./lib/rsession.js"
    },
    "./server": {
      "types": "./lib/types/server/index.d.ts",
      "default": "./lib/server.js"
    },
    "./session-persistence": {
      "types": "./lib/types/session-persistence/routing.d.ts",
      "default": "./lib/session-persistence.js"
    },
    "./src/*": "./src/*"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "packageManager": "pnpm@10.34.6",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/graydovee/dsh-remote-workspace"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-modules"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsdown"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-agent-loop": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-bash-sandbox": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-credentials": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-fs": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-fs-local": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-fs-sandbox": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-fs-ssh": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-host-webserver": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox-local": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox-policy": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-sandbox-ssh": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session-persistence": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session-persistence-jsonl": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session-projection": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-session-title": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-ssh": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-storage-domain": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subprocess": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subprocess-local": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-subprocess-ssh": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tool-bash": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tool-fs": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tool-fs-search": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.3.0",
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-fs-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-fs-sandbox": {
      "optional": true
    },
    "@deepseek-ai/dsh-sandbox-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-subprocess-local": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence-jsonl": {
      "optional": true
    }
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "ssh2": "^1.16.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.2",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.1",
    "@deepseek-ai/dsh-agent-preset-registry": "0.2.0-rc.1",
    "@deepseek-ai/dsh-credentials": "0.2.0-rc.1",
    "@deepseek-ai/dsh-fs": "0.2.0-rc.1",
    "@deepseek-ai/dsh-fs-local": "0.2.0-rc.1",
    "@deepseek-ai/dsh-fs-sandbox": "0.2.0-rc.1",
    "@deepseek-ai/dsh-fs-ssh": "0.2.0-rc.1",
    "@deepseek-ai/dsh-host-webserver": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox-local": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.1",
    "@deepseek-ai/dsh-sandbox-ssh": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-persistence": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-persistence-jsonl": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session-title": "0.2.0-rc.1",
    "@deepseek-ai/dsh-ssh": "0.2.0-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess-local": "0.2.0-rc.1",
    "@deepseek-ai/dsh-subprocess-ssh": "0.2.0-rc.1",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.1",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "@types/ssh2": "^1.15.5",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
